<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <div class="flex gap-3 items-center min-w-0">
    <.link href={~p"/sources"}>
      <.icon name="hero-arrow-left" class="w-10 h-10 hover:dark:text-white" />
    </.link>
    <h2 class="text-title-md2 font-bold text-black dark:text-white ml-4 truncate">
      {@source.custom_name}
    </h2>
  </div>

  <nav>
    <.link href={~p"/sources/#{@source}/edit"}>
      <.button color="bg-primary" rounding="rounded-lg">
        <.icon name="hero-pencil-square" class="mr-2" /> Edit <span class="hidden sm:inline pl-1">Source</span>
      </.button>
    </.link>
  </nav>
</div>
<div
  :if={podcast_missing_url_base?(@source)}
  class="mb-6 rounded-xs border border-warning bg-warning/10 px-5 py-4 text-warning"
>
  This source is set to publish as a podcast, but the
  <.subtle_link href={~p"/settings"}>Podcast URL Base setting</.subtle_link>
  is not set — its feed, cover, and OPML files won't be generated until it is.
</div>
<div class="rounded-xs border border-stroke bg-white px-5 py-5 shadow-default dark:border-strokedark dark:bg-boxdark sm:px-7.5">
  <div class="max-w-full">
    <.tabbed_layout>
      <:tab_append>
        <.actions_dropdown source={@source} conn={@conn} />
      </:tab_append>

      <:tab title="Source" id="source">
        <div class="flex flex-col text-white gap-10">
          <section :if={static_podcast_feed_url(@source)}>
            <h3 class="font-bold text-xl mb-2 mt-6">Podcast Feed</h3>
            <p class="mb-2 text-sm max-w-prose">
              Tubeless has generated this source's static podcast feed on disk. It does <strong>not</strong>
              serve the feed itself — a separate static web server (nginx, Caddy, etc.) must be pointed
              at your podcast library for the URL below to work. If you haven't set that up yet, the URL
              won't resolve.
            </p>
            <p class="mb-2 text-sm max-w-prose">
              Once that server is serving your podcast library, subscribe to this URL in a podcast app (click to copy):
            </p>
            <span
              class="cursor-pointer"
              x-data="{ copied: false }"
              x-on:click={~s"
                copyWithCallbacks(
                  '#{static_podcast_feed_url(@source)}',
                  () => copied = true,
                  () => copied = false
                )
              "}
            >
              <code class="font-mono text-sm break-all underline decoration-bodydark decoration-1 hover:decoration-white">
                {static_podcast_feed_url(@source)}
              </code>
              <span x-show="copied" x-transition.duration.150ms><.icon name="hero-check" class="ml-1 h-4 w-4" /></span>
            </span>
            <p class="mt-3 mb-1 text-sm max-w-prose">
              Tubeless published these files (feed, cover, and episodes) to:
            </p>
            <code class="font-mono text-sm break-all">{static_podcast_local_path(@source)}</code>
            <p class="mt-3 text-sm max-w-prose">
              See the
              <.subtle_link
                href="https://github.com/CommunityMaintained/tubeless/wiki/Podcast-RSS-Feeds"
                target="_blank"
              >
                Podcast RSS Feeds wiki page
              </.subtle_link>
              for how to serve the library.
            </p>
          </section>
          <section :if={static_podcast_feed_pending?(@source)}>
            <h3 class="font-bold text-xl mb-2 mt-6">Podcast Feed</h3>
            <p class="mb-2 text-sm max-w-prose">
              This source is set to publish as a static podcast. Its feed is being generated in the
              background and its subscribe URL will appear here once <code class="font-mono">feed.xml</code>
              has been written. Check the <.subtle_link href={~p"/diagnostics"}>job diagnostics</.subtle_link>
              if it doesn't appear after downloads complete.
            </p>
          </section>
          <section>
            <h3 class="font-bold text-xl mb-2 mt-6">Raw Attributes</h3>
            <section>
              <strong>Media Profile:</strong>
              <.subtle_link href={~p"/media_profiles/#{@source.media_profile_id}"}>
                {@source.media_profile.name}
              </.subtle_link>
            </section>

            <.list_items_from_map map={Map.from_struct(@source)} />
          </section>
        </div>
      </:tab>
      <:tab title="Pending" id="pending">
        {live_render(
          @conn,
          PinchflatWeb.Sources.MediaItemTableLive,
          session: %{"source_id" => @source.id, "media_state" => "pending"}
        )}
      </:tab>
      <:tab title="Downloaded" id="downloaded">
        {live_render(
          @conn,
          PinchflatWeb.Sources.MediaItemTableLive,
          session: %{"source_id" => @source.id, "media_state" => "downloaded"}
        )}
      </:tab>
      <:tab title="Other" id="other">
        {live_render(
          @conn,
          PinchflatWeb.Sources.MediaItemTableLive,
          session: %{"source_id" => @source.id, "media_state" => "other"}
        )}
      </:tab>
      <:tab title="Tasks" id="tasks">
        <%= if match?([_|_], @pending_tasks) do %>
          <.table rows={@pending_tasks} table_class="text-black dark:text-white">
            <:col :let={task} label="Worker">
              {task.job.worker}
            </:col>
            <:col :let={task} label="State">
              {task.job.state}
            </:col>
            <:col :let={task} label="Scheduled At">
              <.datetime_in_zone datetime={task.job.scheduled_at} />
            </:col>
          </.table>
        <% else %>
          <p>Nothing Here!</p>
        <% end %>
      </:tab>
    </.tabbed_layout>
  </div>
</div>
