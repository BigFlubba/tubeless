<% storage = @system_status.storage %>
<% {activity_label, activity_class} = activity_status(@system_status.queues) %>
<div class="rounded-xs border border-strokedark bg-boxdark px-4 py-4 shadow-default sm:px-6">
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <.link
      href={~p"/sources"}
      class="flex min-h-[80px] flex-col justify-between gap-2 rounded-lg border border-strokedark/50 bg-meta-4 p-3 transition-colors hover:border-primary/50 hover:bg-primary/10 active:bg-primary/20 sm:min-h-[88px] sm:p-4"
    >
      <p class="truncate text-xs font-semibold text-bodydark sm:text-sm">Sources</p>
      <div class="min-w-0">
        <p class="truncate text-lg font-bold text-white sm:text-xl">
          <.localized_number number={@system_status.sources.total} />
          <.pluralize count={@system_status.sources.total} word="source" />
        </p>
        <p class="truncate text-xs text-bodydark">
          {@system_status.sources.enabled} enabled · <.localized_number number={@system_status.sources.profile_count} />
          <.pluralize count={@system_status.sources.profile_count} word="profile" />
        </p>
      </div>
    </.link>

    <.link
      href={~p"/sources"}
      class="flex min-h-[80px] flex-col justify-between gap-2 rounded-lg border border-strokedark/50 bg-meta-4 p-3 transition-colors hover:border-primary/50 hover:bg-primary/10 active:bg-primary/20 sm:min-h-[88px] sm:p-4"
    >
      <p class="truncate text-xs font-semibold text-bodydark sm:text-sm">Library</p>
      <div class="min-w-0">
        <p class="truncate text-lg font-bold text-white sm:text-xl">
          <.localized_number number={@system_status.library.downloaded} />
          <.pluralize count={@system_status.library.downloaded} word="media" suffix="" /> ·
          <.readable_filesize byte_size={@system_status.library.size_bytes} precision={0} />
        </p>
        <%= if storage_measured?(storage.media) do %>
          <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-strokedark">
            <div
              class={"h-full #{storage_pressure_class(storage.media, :media)}"}
              style={"width: #{storage_used_percent(storage.media)}%"}
            >
            </div>
          </div>
        <% end %>
        <p class="mt-1 truncate text-xs text-bodydark">{storage_free_label(storage.media)}</p>
      </div>
    </.link>

    <.link
      href={~p"/diagnostics"}
      class="flex min-h-[80px] flex-col justify-between gap-2 rounded-lg border border-strokedark/50 bg-meta-4 p-3 transition-colors hover:border-primary/50 hover:bg-primary/10 active:bg-primary/20 sm:min-h-[88px] sm:p-4"
    >
      <p class="truncate text-xs font-semibold text-bodydark sm:text-sm">Activity</p>
      <div class="min-w-0">
        <p class={"truncate text-lg font-bold sm:text-xl #{activity_class}"}>{activity_label}</p>
        <p class="truncate text-xs text-bodydark">
          <.localized_number number={@system_status.queues.waiting} /> queued ·
          <span class={if @system_status.failed_recently > 0, do: "text-red-400", else: ""}>
            <.localized_number number={@system_status.failed_recently} />
            failed ({@system_status.failure_window_hours}h)
          </span>
        </p>
      </div>
    </.link>

    <.link
      href={~p"/diagnostics"}
      class="flex min-h-[80px] flex-col justify-between gap-2 rounded-lg border border-strokedark/50 bg-meta-4 p-3 transition-colors hover:border-primary/50 hover:bg-primary/10 active:bg-primary/20 sm:min-h-[88px] sm:p-4"
    >
      <p class="truncate text-xs font-semibold text-bodydark sm:text-sm">Database</p>
      <div class="min-w-0">
        <p class="truncate text-lg font-bold text-white sm:text-xl">
          <.readable_filesize byte_size={@system_status.database.size_bytes} precision={0} />
        </p>
        <%= if storage.collocated or not storage_measured?(storage.database) do %>
          <p class="truncate text-xs text-bodydark">
            {reclaimable_notice(@system_status.database) || wal_notice(@system_status.database) || "on media volume"}
          </p>
        <% else %>
          <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-strokedark">
            <div
              class={"h-full #{storage_pressure_class(storage.database, :database)}"}
              style={"width: #{storage_used_percent(storage.database)}%"}
            >
            </div>
          </div>
          <p class="mt-1 truncate text-xs text-bodydark">{storage_free_label(storage.database)}</p>
        <% end %>
      </div>
    </.link>
  </div>

  <%= if attention_present?(@system_status.attention) do %>
    <.link
      href={~p"/diagnostics"}
      class="mt-3 block rounded border border-red-500/50 bg-red-500/10 px-3 py-2 text-xs text-red-200 hover:bg-red-500/20"
    >
      Jobs need attention — Retryable {@system_status.attention.retryable} · Discarded {@system_status.attention.discarded} · Orphaned source jobs {@system_status.attention.orphaned} · Stalled {@system_status.attention.stalled}. View Diagnostics.
    </.link>
  <% end %>
</div>

<div class="rounded-xs border shadow-default border-strokedark bg-boxdark mt-4 p-5">
  <span class="text-2xl font-medium mb-4">Media History</span>
  <.tabbed_layout>
    <:tab title="Downloaded" id="downloaded">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "downloaded"}
      )}
    </:tab>
    <:tab title="Downloading" id="downloading">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "downloading"}
      )}
    </:tab>
    <:tab title="Queued" id="queued">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "queued"}
      )}
    </:tab>
    <:tab title="Pending" id="pending">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "pending"}
      )}
    </:tab>
  </.tabbed_layout>
</div>

<div class="rounded-xs border shadow-default border-strokedark bg-boxdark mt-4 p-5">
  <span class="text-2xl font-medium mb-4">Active Tasks</span>
  <section class="mt-6 min-h-80">
    {live_render(@conn, Pinchflat.Pages.JobTableLive)}
  </section>
</div>
