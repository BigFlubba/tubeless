<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <div class="flex gap-3 items-center">
    <h2 class="text-title-md2 font-bold text-black dark:text-white ml-4">
      Settings
    </h2>
  </div>
</div>
<div class="rounded-xs border border-stroke bg-white px-5 py-5 shadow-default dark:border-strokedark dark:bg-boxdark sm:px-7.5">
  <div class="max-w-full">
    <.setting_form conn={@conn} changeset={@changeset} action={~p"/settings"} />
  </div>
</div>
<div class="mt-6 rounded-xs border border-stroke bg-white px-5 py-5 shadow-default dark:border-strokedark dark:bg-boxdark sm:px-7.5">
  <div class="max-w-full">
    <h3 class="text-2xl text-black dark:text-white mb-2">
      Proxy
    </h3>
    {live_render(@conn, Pinchflat.Settings.ProxyLive, id: "proxy-live")}
    <div class="mt-6 border-t border-stroke pt-6 dark:border-strokedark">
      {live_render(@conn, Pinchflat.Settings.ProxyFileLive, id: "proxy-file-live")}
    </div>
  </div>
</div>
<div class="mt-6 rounded-xs border border-stroke bg-white px-5 py-5 shadow-default dark:border-strokedark dark:bg-boxdark sm:px-7.5">
  <div class="max-w-full">
    <h3 class="text-2xl text-black dark:text-white mb-2">
      Cookies
    </h3>
    {live_render(@conn, Pinchflat.Settings.CookieFileLive, id: "cookie-file-live")}
  </div>
</div>
